# Terraform working directory
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
**/terraform.tfstate
**/terraform.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
tfplan

# Sensitive variable files
*.tfvars
*.tfvars.json

# Exception: example variable file
!terraform.tfvars.example
!**/terraform.tfvars.example

# Local environment files
.env
.env.*

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file should NOT be ignored
# .terraform.lock.hcl should be committed
